          "color": "#000000",
          "lineHeight": 1.556,
          "lineHeight_source": "fixed (lineHeightPx÷fontSize)",
          "letterSpacing": "-0.05em"
        },
        {
          "text": "매출 점검, 운영 개선, 서비스 관리 등 현장에서 필요한 부분을 함께 점검",
          "fontSize_px": 18,
